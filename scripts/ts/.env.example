# ==============================================================================
# EVVM Signing Script (TypeScript) - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file.
# ==============================================================================

# EVVM Authorizer private key (with 0x prefix)
# This is the private key of the address configured as evvmAuthorizer
# in the UserValidatorPreRegistrated contract
EVVM_AUTHORIZER_PRIVATE_KEY=0x...
